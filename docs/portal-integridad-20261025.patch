+    await db.query('UPDATE portal_intranet_sync SET revision=?,contenido=?,body_hash=?,property_id=NULL WHERE clave=?',[body.revision,JSON.stringify({status:'deleted'}),hash,key]);
+    await db.commit();return {ok:true,deleted:true,sourceId:body.sourceId};
+   }
    if(body.status==='published'){
     const s=body.snapshot;const description=escaped(s.description).replace(/\r?\n/g,'<br>');if(description.length>10000)throw new Error('invalid');
     if(!id&&s.existingPortalId!=null){
